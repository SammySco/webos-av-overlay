#!/bin/sh
SCRIPT=$(readlink -f "$0" 2>/dev/null || printf '%s' "$0")
APP_DIR=$(dirname "$(dirname "$SCRIPT")")
WATCHER="$APP_DIR/runtime/watcher.js"
PIDFILE=/tmp/earc-volume-overlay.pid

[ -f "$WATCHER" ] || exit 1

if [ -f "$PIDFILE" ]; then
	pid=$(cat "$PIDFILE" 2>/dev/null)
	if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null \
		&& tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null | grep -q "$WATCHER"; then
		exit 0
	fi
fi

/usr/bin/node "$WATCHER" </dev/null >/tmp/earc-volume-overlay.stdout 2>&1 &
echo $! > "$PIDFILE"
exit 0

# Copy this file to .env and fill in your values.
# .env is git-ignored; never commit it (it holds the path to your SSH key).

# SSH host for the TV (user@ip).  The watcher calls luna-send on the TV via SSH.
TV_HOST=root@192.168.0.194

# Path to the SSH private key that has root access to the TV.
# The file is bind-mounted read-only into the container at /run/secrets/tv_ssh_key.
TV_SSH_KEY=~/.ssh/id_rsa

# URL that the TV's overlay WebOS app uses to call back to this watcher.
# Must be an address the TV can reach — usually http://<this-machine-ip>:41101.
# The watcher passes this to the app at launch so pin-state, key forwarding and
# on-demand requests all reach the container rather than 127.0.0.1 on the TV.
WATCHER_URL=http://192.168.0.5:41101

# Yamaha receiver IP address (required; can also be entered via the /setup page).
AMP_HOST=192.168.0.108

# Receiver HTTP port (default 80; uncomment only if non-standard)
# AMP_PORT=80

# Port the watcher HTTP server listens on (default 41101)
# INFO_PORT=41101
